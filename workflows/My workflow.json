    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet articlesText = items.map(item => {\n  const j = item.json;\n  return `Title: ${j.title}\\nLink: ${j.link}\\nSummary: ${j.contentSnippet || j.content || ''}\\n`;\n}).join('\\n---\\n');\n\nreturn [{ json: { articles: articlesText } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
